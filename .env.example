# Ключ API OpenAI. Создайте новый ключ после отзыва ранее раскрытого.
OPENAI_API_KEY=ВСТАВЬТЕ_НОВЫЙ_КЛЮЧ

# Модель Pydantic AI.
MODEL_NAME=openai:gpt-6-luna

# Максимум генерируемых токенов на один ответ агента (от 4096 до 32768).
MAX_OUTPUT_TOKENS=16384

# Максимальные расходы на все запросы за календарный день в долларах США.
DAILY_BUDGET_USD=1.00

# Стоимость одного вызова веб-поиска OpenAI в долларах США (текущий тариф — $0.01).
WEB_SEARCH_CALL_COST_USD=0.01

# Настройки журналирования: уровень DEBUG, INFO, WARNING, ERROR или CRITICAL.
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30

# Git
GIT_MAIN_BRANCH=main
GIT_REMOTE_URL=git@github.com:indeed-aa/dunno.git
GIT_SSH_KEY_PATH=~/.ssh/dunno-deploy
GIT_PUSH_ENABLED=true

# Изоляция кандидатов
DOCKER_IMAGE=selfagent:dev
DOCKER_TIMEOUT_SECONDS=900

